{
    "name": "directorytree/operations",
    "description": "Run one-time deployment operations in Laravel.",
    "type": "library",
    "keywords": ["laravel", "operations", "deployment", "migrations", "seeders"],
    "license": "MIT",
    "authors": [{"name": "Steve Bauman", "email": "steven_bauman@outlook.com"}],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {"psr-4": {"DirectoryTree\\Operations\\": "src/"}},
    "autoload-dev": {"psr-4": {"DirectoryTree\\Operations\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["DirectoryTree\\Operations\\OperationsServiceProvider"]}},
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {"pestphp/pest-plugin": true}
    }
}
